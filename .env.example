# Upstash Redis — create a free database at https://console.upstash.com
# then copy the REST URL and REST token from the database's "REST API" tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The PIN your team enters to reach the dashboard. Pick anything you like.
TEAM_PIN=

# A long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
